---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../lib/base';
---

<BaseLayout title="Page introuvable" description="Page non trouvée — Riyad Zaer Gardens" noindex>
  <div class="notfound relative flex min-h-screen flex-col overflow-hidden bg-foret text-creme">
    <img
      src={withBase('/gallery/render-7.jpg')}
      alt=""
      class="notfound__bg absolute inset-0 h-full w-full object-cover opacity-[0.22]"
      aria-hidden="true"
    />
    <div class="notfound__veil absolute inset-0 bg-gradient-to-br from-foret via-foret/95 to-canopee/90" aria-hidden="true"></div>
    <div class="notfound__glow absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(200,181,104,0.14),transparent_55%)]" aria-hidden="true"></div>

    <header class="relative z-10 flex items-center justify-between px-4 pt-8 sm:px-6">
      <a href={withBase('/')} class="inline-block" aria-label={site.name}>
        <img src={withBase('/logo.png')} alt="" width="140" height="56" class="h-9 w-auto opacity-90 transition hover:opacity-100" />
      </a>
      <div class="lang-toggle flex rounded-full border border-creme/20 p-0.5 text-[0.65rem] font-semibold" role="group">
        <button type="button" data-lang="fr" aria-pressed="true" class="rounded-full px-2.5 py-1">FR</button>
        <button type="button" data-lang="ar" aria-pressed="false" class="rounded-full px-2.5 py-1">AR</button>
      </div>
    </header>

    <main class="relative z-10 flex flex-1 flex-col items-center justify-center px-4 pb-20 pt-8 text-center sm:px-6">
      <p class="kicker mb-5" data-i18n="notfound_kicker">Erreur 404</p>
      <div class="gold-rule mx-auto mb-8"></div>

      <p class="font-display text-[clamp(5rem,18vw,9rem)] leading-none text-gold/90" aria-hidden="true">404</p>

      <h1 class="font-display mt-6 max-w-lg text-3xl leading-tight md:text-4xl" data-i18n="notfound_title">
        Cette adresse n'existe pas encore
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-creme/78" data-i18n="notfound_lead">
        La page que vous cherchez a peut-être été déplacée. Retournez à l'accueil ou contactez-nous — nous vous guidons vers la bonne adresse.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={withBase('/')} class="btn btn-solid" data-i18n="notfound_home">Retour à l'accueil</a>
        <a href={withBase('/contact/')} class="btn btn-ghost" data-i18n="cta_contact">Nous contacter</a>
      </div>
      <a
        href={site.whatsapp}
        class="mt-6 text-sm text-creme/60 transition hover:text-gold-soft"
        target="_blank"
        rel="noopener"
        data-i18n="cta_whatsapp"
      >
        WhatsApp
      </a>
    </main>

    <footer class="relative z-10 border-t border-creme/10 px-4 py-6 text-center text-xs uppercase tracking-[0.22em] text-creme/40">
      <span data-i18n="by_manoussa">by La Manoussa</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .lang-toggle button[aria-pressed='true'] {
    background: var(--color-gold);
    color: var(--color-foret);
  }
  .notfound__bg {
    animation: notfound-drift 28s ease-in-out infinite alternate;
  }
  @keyframes notfound-drift {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .notfound__bg {
      animation: none;
    }
  }
</style>
