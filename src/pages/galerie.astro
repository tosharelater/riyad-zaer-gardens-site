---
import PageLayout from '../layouts/PageLayout.astro';
import { galleryImages } from '../data/site';
---

<PageLayout title="Galerie" current="gallery">
  <div class="fusion-page" data-fusion-page>
    <section class="bg-foret px-4 pb-12 pt-16 text-creme sm:px-6 md:pt-24">
      <div class="mx-auto max-w-7xl" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">Galerie</p>
        <h1 class="fusion-h1 mt-6 max-w-[16ch] reveal-fusion">
          <span data-bilingual-fr>Le quartier, en images</span>
          <span data-bilingual-ar hidden>الحي، في صور</span>
        </h1>
      </div>
    </section>
    <section class="bg-creme">
      <div class="mx-auto grid max-w-7xl sm:grid-cols-2 lg:grid-cols-3">
        {galleryImages.map((img, i) => (
          <figure class:list={['relative min-h-[18rem] overflow-hidden bg-foret', i === 0 && 'sm:col-span-2 sm:min-h-[32rem]']}>
            <img
              src={img.src}
              alt={img.altFr}
              loading="lazy"
              class="h-full w-full object-cover transition duration-700 ease-out hover:scale-[1.04]"
              data-bilingual-alt-fr={img.altFr}
              data-bilingual-alt-ar={img.altAr}
            />
          </figure>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
