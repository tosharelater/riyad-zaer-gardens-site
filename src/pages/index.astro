---
import PageLayout from '../layouts/PageLayout.astro';
import { site, typologies, amenities, timeline, faq } from '../data/site';
import {
  poleUrban,
  accessPoints,
  aidSteps,
  chantierDetail,
  developer,
  visitInfo,
} from '../data/home-content';
import { withBase } from '../lib/base';

const heroSlides = [withBase('/gallery/render-11.jpg'), withBase('/gallery/render-6.jpg'), withBase('/gallery/render-5.jpg')];
const typoImages = [withBase('/gallery/render-1.jpg'), withBase('/gallery/render-6.jpg'), withBase('/gallery/render-8.jpg')];
const progressPct = 55;
---

<PageLayout title="Accueil" current="home">
  <div class="fusion-page" data-fusion-page>
    <div class="fusion-progress" data-scroll-progress aria-hidden="true"></div>

    <section class="fusion-hero text-creme">
      <div class="fusion-hero__media fusion-media fusion-media--crossfade" data-hero-crossfade>
        {heroSlides.map((src, i) => <img src={src} alt="" class:list={[i === 0 && 'is-active']} />)}
      </div>
      <div class="fusion-hero__veil" aria-hidden="true"></div>
      <div class="fusion-hero__copy" data-reveal-group>
        <p class="fusion-kicker reveal-fusion" data-i18n="hero_kicker">Nouveau pôle urbain à Rabat</p>
        <h1 class="fusion-h1 reveal-fusion reveal-fusion--left">
          <span data-bilingual-fr>Un quartier neuf.<br />Une adresse durable.</span>
          <span data-bilingual-ar hidden>حي جديد.<br />عنوان دائم.</span>
        </h1>
        <p class="fusion-lead text-creme/82 reveal-fusion">
          <span data-bilingual-fr>120 appartements F3 & F4 et 49 fonds de commerce à Aïn Aouda — livraison {site.delivery}.</span>
          <span data-bilingual-ar hidden>120 شقة F3 و F4 و 49 محلاً في عين عودة — التسليم {site.delivery}.</span>
        </p>

        <dl class="fusion-nums reveal-fusion">
          <div>
            <dt><span data-count-to={site.apartments}>0</span></dt>
            <dd data-i18n="stat_apt">appartements</dd>
          </div>
          <div>
            <dt><span data-count-to={site.commercial}>0</span></dt>
            <dd data-i18n="stat_com">commerces</dd>
          </div>
          <div>
            <dt><span data-count-to={25}>0</span>'</dt>
            <dd>
              <span data-bilingual-fr>de Rabat</span>
              <span data-bilingual-ar hidden>من الرباط</span>
            </dd>
          </div>
        </dl>

        <p class="mt-6 text-sm text-creme/70 reveal-fusion">
          {site.priceFrom} · <span data-bilingual-fr>aides jusqu'à {site.aidAmount}</span>
          <span data-bilingual-ar hidden>دعم حتى {site.aidAmount}</span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3 reveal-fusion">
          <a href={withBase('/projet/')} class="btn btn-solid">
            <span data-bilingual-fr>Voir le projet</span>
            <span data-bilingual-ar hidden>عرض المشروع</span>
          </a>
          <a href={withBase('/contact/')} class="btn btn-ghost">
            <span data-bilingual-fr>Planifier une visite</span>
            <span data-bilingual-ar hidden>حدد زيارة</span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-y border-foret/10 bg-white">
      <div class="mx-auto grid max-w-7xl grid-cols-2 md:grid-cols-4" data-reveal-group>
        {[
          { v: site.priceFrom, l: 'dès', la: 'من' },
          { v: site.aidAmount, l: 'aide max', la: 'دعم max' },
          { v: site.delivery, l: 'livraison', la: 'التسليم' },
          { v: site.locationReal, l: 'secteur', la: 'المنطقة' },
        ].map((item) => (
          <div class="fusion-proof-cell border-e border-foret/10 px-5 py-7 last:border-e-0 reveal-fusion">
            <p class="fusion-proof-val font-display text-2xl text-canopee">{item.v}</p>
            <p class="mt-1 text-[0.65rem] uppercase tracking-[0.16em] text-foret/50">
              <span data-bilingual-fr>{item.l}</span>
              <span data-bilingual-ar hidden>{item.la}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="fusion-split fusion-split--short bg-creme">
      <div class="fusion-pane" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">01 — Le projet</p>
        <h2 class="fusion-h2 mt-6 reveal-fusion">
          <span data-bilingual-fr>{poleUrban.titleFr}</span>
          <span data-bilingual-ar hidden>{poleUrban.titleAr}</span>
        </h2>
        <p class="fusion-lead text-foret/72 reveal-fusion">
          <span data-bilingual-fr>{poleUrban.bodyFr}</span>
          <span data-bilingual-ar hidden>{poleUrban.bodyAr}</span>
        </p>
      </div>
      <div class="fusion-media" data-media-reveal>
        <img src={withBase('/gallery/render-4.jpg')} alt="" />
      </div>
    </section>

    <section id="typologies" class="bg-white">
      <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 md:pt-24" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">02 — Typologies</p>
        <h2 class="fusion-h2 mt-6 reveal-fusion">F3 · F4 · Commerce</h2>
      </div>
      <div class="fusion-row mt-12">
        {typologies.map((t, i) => (
          <article data-row-reveal>
            <div class="fusion-row__img">
              <img src={typoImages[i]} alt="" loading="lazy" />
            </div>
            <div class="fusion-row__copy">
              <p class="text-[0.65rem] uppercase tracking-[0.2em] text-gold">{t.surface}</p>
              <h3 class="font-display mt-3 text-4xl text-canopee">
                <span data-bilingual-fr>{t.titleFr}</span>
                <span data-bilingual-ar hidden>{t.titleAr}</span>
              </h3>
              <p class="mt-4 max-w-sm text-sm leading-relaxed text-foret/70">
                <span data-bilingual-fr>{t.bodyFr}</span>
                <span data-bilingual-ar hidden>{t.bodyAr}</span>
              </p>
              <p class="mt-6 font-medium text-canopee">
                <span data-bilingual-fr>{t.priceFr}</span>
                <span data-bilingual-ar hidden>{t.priceAr}</span>
              </p>
              <p class="mt-3 text-sm text-foret/55">
                <span data-bilingual-fr>{t.remaining} lots restants</span>
                <span data-bilingual-ar hidden>{t.remaining} وحدات متبقية</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="aides" class="fusion-split fusion-split--short">
      <div class="fusion-pane bg-creme" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">03 — Équipements</p>
        <h2 class="fusion-h2 mt-6 reveal-fusion">
          <span data-bilingual-fr>Confort au quotidien</span>
          <span data-bilingual-ar hidden>راحة يومية</span>
        </h2>
        <ul class="fusion-list mt-10 border-foret/10 text-foret">
          {amenities.map((a) => (
            <li class="border-foret/10 reveal-fusion">
              <span data-bilingual-fr>{a.fr}</span>
              <span data-bilingual-ar hidden>{a.ar}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="fusion-pane bg-canopee text-creme" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">04 — Aides</p>
        <h2 class="fusion-h2 mt-6 text-creme reveal-fusion">Daam Sakane</h2>
        <p class="fusion-lead text-creme/80 reveal-fusion">
          <span data-bilingual-fr>Jusqu'à {site.aidAmount} — indicatif {site.priceWithAid} avec aide.</span>
          <span data-bilingual-ar hidden>حتى {site.aidAmount} — تقريبي {site.priceWithAid} مع الدعم.</span>
        </p>
        <ol class="fusion-steps mt-10">
          {aidSteps.map((step) => (
            <li class="reveal-fusion">
              <span>
                <span data-bilingual-fr>{step.fr}</span>
                <span data-bilingual-ar hidden>{step.ar}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="chantier" class="fusion-band bg-foret text-creme">
      <div class="mx-auto max-w-5xl px-4 sm:px-6" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">05 — Chantier</p>
        <h2 class="fusion-h2 mt-6 reveal-fusion">
          <span data-bilingual-fr>{chantierDetail.phaseFr}</span>
          <span data-bilingual-ar hidden>{chantierDetail.phaseAr}</span>
        </h2>
        <p class="fusion-lead text-creme/75 reveal-fusion">
          <span data-bilingual-fr>{chantierDetail.noteFr}</span>
          <span data-bilingual-ar hidden>{chantierDetail.noteAr}</span>
        </p>
        <div class="mt-12 reveal-fusion">
          <div class="flex justify-between text-[0.65rem] uppercase tracking-[0.18em] text-creme/50">
            <span>Livraison {site.delivery}</span>
            <span>{progressPct}%</span>
          </div>
          <div class="fusion-track mt-3" data-fill-track style={`--fill:${progressPct}%`}><span></span></div>
        </div>
        <ol class="fusion-phases reveal-fusion" data-phase-track>
          {timeline.map((step, i) => (
            <li class:list={[{ 'is-now': i === 2 }]}>
              <p class="text-[0.6rem] uppercase tracking-wider text-gold-soft">
                <span data-bilingual-fr>{step.statusFr}</span>
                <span data-bilingual-ar hidden>{step.statusAr}</span>
              </p>
              <p class="font-display mt-2 text-sm">
                <span data-bilingual-fr>{step.titleFr}</span>
                <span data-bilingual-ar hidden>{step.titleAr}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="emplacement" class="fusion-split fusion-split--short bg-creme">
      <div class="fusion-pane" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">06 — Emplacement</p>
        <p class="fusion-giant mt-8 reveal-fusion reveal-fusion--left">25'</p>
        <p class="mt-4 text-xl reveal-fusion">
          <span data-bilingual-fr>minutes de Rabat</span>
          <span data-bilingual-ar hidden>دقيقة من الرباط</span>
        </p>
        <p class="fusion-lead text-foret/70 reveal-fusion">{site.address}</p>
        <ul class="fusion-list mt-10 border-foret/10 text-foret">
          {accessPoints.map((p) => (
            <li class="border-foret/10 reveal-fusion">
              <span data-bilingual-fr>{p.fr}</span>
              <span data-bilingual-ar hidden>{p.ar}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="fusion-media" data-media-reveal>
        <img src={withBase('/gallery/render-11.jpg')} alt="" loading="lazy" />
      </div>
    </section>

    <section class="fusion-split fusion-split--short">
      <div class="fusion-pane bg-white" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">07 — Promoteur</p>
        <h2 class="fusion-h2 mt-6 reveal-fusion">{developer.name}</h2>
        <p class="fusion-lead text-foret/70 reveal-fusion">
          <span data-bilingual-fr>{developer.bodyFr}</span>
          <span data-bilingual-ar hidden>{developer.bodyAr}</span>
        </p>
        <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-foret/10 pt-8 reveal-fusion">
          {developer.stats.map((s) => (
            <div>
              <dt class="font-display text-3xl text-canopee">{s.value}</dt>
              <dd class="mt-2 text-[0.62rem] uppercase tracking-[0.14em] text-foret/50">
                <span data-bilingual-fr>{s.labelFr}</span>
                <span data-bilingual-ar hidden>{s.labelAr}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="fusion-pane bg-creme" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">08 — FAQ</p>
        <div class="fusion-faq mt-8 divide-y divide-foret/10 border-y border-foret/10 reveal-fusion">
          {faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none justify-between gap-4 font-medium">
                <span>
                  <span data-bilingual-fr>{item.qFr}</span>
                  <span data-bilingual-ar hidden>{item.qAr}</span>
                </span>
                <span class="fusion-faq-plus text-gold">+</span>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-foret/70">
                <span data-bilingual-fr>{item.aFr}</span>
                <span data-bilingual-ar hidden>{item.aAr}</span>
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="fusion-band bg-foret text-creme">
      <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 sm:px-6 md:flex-row md:items-end md:justify-between" data-reveal-group>
        <div class="reveal-fusion">
          <p class="fusion-kicker">Visite</p>
          <h2 class="fusion-h2 mt-6">
            <span data-bilingual-fr>{visitInfo.ctaFr}</span>
            <span data-bilingual-ar hidden>{visitInfo.ctaAr}</span>
          </h2>
          <p class="mt-5 text-creme/70">{site.phone} · <span data-bilingual-fr>{visitInfo.hoursFr}</span><span data-bilingual-ar hidden>{visitInfo.hoursAr}</span></p>
        </div>
        <div class="flex flex-wrap gap-3 reveal-fusion">
          <a href={site.whatsapp} class="btn btn-solid" target="_blank" rel="noopener" data-i18n="cta_whatsapp">WhatsApp</a>
          <a href={withBase('/contact/')} class="btn btn-ghost" data-i18n="cta_contact">Nous contacter</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
