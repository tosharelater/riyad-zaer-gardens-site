---
interface Props {
  kicker?: string;
  titleFr: string;
  titleAr: string;
  leadFr?: string;
  leadAr?: string;
  light?: boolean;
  align?: 'left' | 'center';
}
const { kicker, titleFr, titleAr, leadFr, leadAr, light = false, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl reveal', align === 'center' && 'mx-auto text-center']}>
  {kicker && (
    <p class:list={['kicker mb-3', light ? 'kicker--light' : 'kicker--ink']}>{kicker}</p>
  )}
  <div class:list={['gold-rule mb-5', align === 'center' && 'mx-auto']}></div>
  <h2 class="font-display text-3xl md:text-4xl leading-tight">
    <span data-bilingual-fr>{titleFr}</span>
    <span data-bilingual-ar hidden>{titleAr}</span>
  </h2>
  {(leadFr || leadAr) && (
    <p class:list={['mt-4 text-base md:text-lg leading-relaxed', light ? 'text-creme/80' : 'prose-rzg']}>
      <span data-bilingual-fr>{leadFr}</span>
      <span data-bilingual-ar hidden>{leadAr}</span>
    </p>
  )}
</div>
