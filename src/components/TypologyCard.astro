---
interface Props {
  titleFr: string;
  titleAr: string;
  surface: string;
  priceFr: string;
  priceAr: string;
  bodyFr: string;
  bodyAr: string;
  image?: string;
  featured?: boolean;
}
const { titleFr, titleAr, surface, priceFr, priceAr, bodyFr, bodyAr, image, featured = false } = Astro.props;
---

<article class:list={['card card-hover overflow-hidden p-0 reveal', featured && 'md:col-span-2 md:grid md:grid-cols-2']}>
  {image && (
    <div class:list={['relative overflow-hidden', featured ? 'min-h-[220px]' : 'aspect-[16/10]']}>
      <img src={image} alt="" loading="lazy" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-foret/60 to-transparent"></div>
      <p class="absolute bottom-4 start-4 text-xs font-semibold uppercase tracking-widest text-gold-soft">{surface}</p>
    </div>
  )}
  <div class="p-6">
    {!image && <p class="text-xs font-semibold uppercase tracking-widest text-gold">{surface}</p>}
    <h3 class="font-display text-2xl md:text-3xl mt-1">
      <span data-bilingual-fr>{titleFr}</span>
      <span data-bilingual-ar hidden>{titleAr}</span>
    </h3>
    <p class="mt-3 text-sm prose-rzg">
      <span data-bilingual-fr>{bodyFr}</span>
      <span data-bilingual-ar hidden>{bodyAr}</span>
    </p>
    <p class="mt-5 font-medium text-canopee">
      <span data-bilingual-fr>{priceFr}</span>
      <span data-bilingual-ar hidden>{priceAr}</span>
    </p>
  </div>
</article>
