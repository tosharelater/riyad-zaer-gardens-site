---
interface Props {
  kicker?: string;
  titleFr: string;
  titleAr: string;
  leadFr?: string;
  leadAr?: string;
  dark?: boolean;
  image?: string;
}
const { kicker, titleFr, titleAr, leadFr, leadAr, dark = true, image } = Astro.props;
---

<section class:list={['relative overflow-hidden section section--tight', dark ? 'section--canopee' : 'section--soft']}>
  {image && (
    <>
      <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-canopee via-canopee/95 to-canopee/80" aria-hidden="true"></div>
    </>
  )}
  <div class="container-rzg relative max-w-3xl reveal">
    {kicker && <p class="kicker mb-3">{kicker}</p>}
    <div class="gold-rule mb-5"></div>
    <h1 class="font-display text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.1]">
      <span data-bilingual-fr>{titleFr}</span>
      <span data-bilingual-ar hidden>{titleAr}</span>
    </h1>
    {(leadFr || leadAr) && (
      <p class="mt-5 max-w-2xl text-base md:text-lg leading-relaxed text-creme/85">
        <span data-bilingual-fr>{leadFr}</span>
        <span data-bilingual-ar hidden>{leadAr}</span>
      </p>
    )}
  </div>
</section>
